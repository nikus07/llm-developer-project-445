// Политики write-пути агента мобильного оператора (Dogwood: Cedar + temporal).
//
// Цикл «да — что да?»: Prepare → ConfirmCard → Execute.
// Семантика Cedar: deny by default, forbid перекрывает permit. Оператору (olga)
// запись запрещена отсутствием подходящего permit: отдельный forbid не нужен.
//
// Ключи идентичности (user_id/account/subscriber/msisdn) в аргументах не
// существуют: при их появлении ни один permit не срабатывает.

// 1. Prepare — клиент с правом записи; guardrail не против.
permit(principal, action == Tel::Action::"Prepare", resource)
when {
    context.input.role == "client" &&
    context.input.scopes.contains("tariffs:write") &&
    context.input.guard_ok
}
unless {
    context.input has user_id || context.input has account ||
    context.input has subscriber || context.input has msisdn
};

// 2. ConfirmCard — «да» принимается, только если ТА ЖЕ карточка недавно готовилась.
permit(principal, action == Tel::Action::"ConfirmCard", resource)
when {
    context.input.role == "client" &&
    context.input.scopes.contains("tariffs:write") &&
    context.input.guard_ok
}
unless {
    context.input has user_id || context.input has account ||
    context.input has subscriber || context.input has msisdn
}
when temporal {
    formerly within 1h Tel::Action::"Prepare"::request{
        input.pending_id: context.input.pending_id
    }
};

// 3. Execute — только после подтверждения той же карточки.
permit(principal, action == Tel::Action::"Execute", resource)
when {
    context.input.role == "client" &&
    context.input.scopes.contains("tariffs:write") &&
    context.input.guard_ok
}
unless {
    context.input has user_id || context.input has account ||
    context.input has subscriber || context.input has msisdn
}
when temporal {
    formerly within 1h Tel::Action::"ConfirmCard"::request{
        input.pending_id: context.input.pending_id
    }
};

// 4. Лимит: не более двух смен тарифа за сессию. Запрос на третье исполнение
//    уже входит в историю, поэтому порог — «больше двух». Услуги и контакты
//    лимит не расходуют: считаются только исполнения tariff_change.
forbid(principal, action == Tel::Action::"Execute", resource)
when { context.input.action == "tariff_change" }
when temporal {
    exists (n: Long). (
        (count for (t: Timepoint). where (
            formerly within 24h (
                Tel::Action::"Execute"::request{ input.action: "tariff_change" } && tp(t)
            )
        )) == n && n > 2
    )
};
